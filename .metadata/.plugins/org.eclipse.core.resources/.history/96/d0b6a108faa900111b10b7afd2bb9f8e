	/*
	 * Deselecting: for a multi-select, calling selectOption() with a value list
	 * that excludes an option deselects it; passing an empty array deselects
	 * everything. Playwright has no per-option deselect call because the whole
	 * selection is set atomically.
	 */
	public void deselectByValue(Locator dropdown, String value, String elementName) {
		try {
			List<String> remaining = new ArrayList<>();
			for (String v : getSelectedValues(dropdown)) {
				if (!v.equals(value)) {
					remaining.add(v);
				}
			}
			dropdown.selectOption(remaining.toArray(new String[0]));
			getExtentTest().log(Status.INFO, "Element deselected  By deselectByValue");
		} catch (Exception e) {
			getExtentTest().log(Status.FAIL, "Did not deselected value by deselectByValue");
			throw e;
		}
	}

	public void deselectByVisibleText(Locator dropdown, String visibleValue, String elementName) {
		try {
			List<String> remaining = new ArrayList<>();
			for (String text : getAllSelectedOption(dropdown, elementName)) {
				if (!text.equals(visibleValue)) {
					remaining.add(text);
				}
			}
			SelectOption[] opts = remaining.stream().map(t -> new SelectOption().setLabel(t))
					.toArray(SelectOption[]::new);
			dropdown.selectOption(opts);
			getExtentTest().log(Status.INFO, "element deselected succesfully by deselectByVisibleText");
		} catch (Exception e) {
			getExtentTest().log(Status.INFO, "Did not deselected value by deselectByVisibleText");
		}
	}

