	/*
	 * Launches a browser by name. Playwright has three engines (chromium, firefox,
	 * webkit) rather than one driver class per vendor. "edgebrowser" maps to
	 * Chromium's "msedge" channel and "safaribrowser" maps to WebKit, which is the
	 * closest Playwright equivalent to Safari.
	 */
	public void launchBrowser(String browserName) {
		try {
			Playwright playwright = Playwright.create();
			poolPlaywright.set(playwright);
			Browser browser;
			switch (browserName) {
			case "chromebrowser":
				browser = playwright.chromium().launch(new BrowserType.LaunchOptions().setHeadless(false).setSlowMo(1000));
				break;
			case "firebrowser":
				browser = playwright.firefox().launch(new BrowserType.LaunchOptions().setHeadless(false));
				break;
			case "edgebrowser":
				browser = playwright.chromium()
						.launch(new BrowserType.LaunchOptions().setHeadless(false).setChannel("msedge"));
				break;
			case "safaribrowser":
				browser = playwright.webkit().launch(new BrowserType.LaunchOptions().setHeadless(false));
				break;
			default:
				throw new IllegalArgumentException("Unknown browser: " + browserName);
			}
			poolBrowser.set(browser);
			BrowserContext context = browser.newContext();
			poolContext.set(context);
			Page newPage = context.newPage();
			poolPage.set(newPage);
			getExtentTest().log(Status.INFO, browserName + ": launched succesfully");
		} catch (Exception e) {
			getExtentTest().log(Status.FAIL, "Failed To Launched Browser");
			throw e;
		}
	}

