	/*
	 * Standard interactions. Playwright's fill/click/clear already retry and wait
	 * for actionability, so the layered exception handling from the Selenium
	 * version collapses to a single try/catch with a JS fallback kept for parity.
	 */
	public void inputValue(Locator element, String input, String elementName) {
		try {
			element.fill(input);
			getExtentTest().log(Status.INFO, " sendKeys actions performe succefully on-[" + elementName + "]-");
		} catch (PlaywrightException e) {
			jssendKeys(element, input, elementName);
			getExtentTest().log(Status.INFO,
					" after handling PlaywrightException jsSendKeys actions performed succesfully on: " + elementName);
			addcapture(element, elementName);
		} catch (Exception e) {
			getExtentTest().log(Status.FAIL, " Did not perform sendKeys action on-[ " + elementName + " ]" + "");
			throw e;
		}
	}

