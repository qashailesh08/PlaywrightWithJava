	/*
	 * Playwright handles native dialogs (alert/confirm/prompt) via an event
	 * listener registered before the action that triggers them, rather than a
	 * driver.switchTo().alert() call made after the fact. Register this once per
	 * page (e.g. right after launchBrowser) before triggering the dialog.
	 */
	public void handleAlert(String yesORno) {
		getPage().onDialog((Dialog dialog) -> {
			if (yesORno.contains("ok")) {
				dialog.accept();
				getExtentTest().log(Status.INFO, "Alert Accepted");
			} else if (yesORno.contains("no")) {
				dialog.dismiss();
				getExtentTest().log(Status.INFO, "Alert Dismissed");
			}
		});
	}

	/*
	 * Kept for direct parity, but Playwright's auto-waiting generally removes the
	 * need for static sleeps - prefer waitFor()/assertThat() where possible.
	 */
	public void staticWait(long time) {
		try {
			Thread.sleep(time);
			getExtentTest().log(Status.INFO, "Static wait applyed successfully");
		} catch (InterruptedException e) {
			getExtentTest().log(Status.FAIL, "Static wait Did not apply");
			e.printStackTrace();
		}
	}

