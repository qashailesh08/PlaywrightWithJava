	/*
	 * Waits. Playwright's own click()/fill()/etc. already wait for an element to be
	 * visible, stable, enabled and receive events before acting, so most explicit
	 * ExpectedConditions calls become unnecessary. waitFor() is kept for cases
	 * where a bare visibility/attachment check is needed without an accompanying
	 * action.
	 */
	public void waitforElementVisibilty(Locator element, String elementName) {
		try {
			element.waitFor(new Locator.WaitForOptions().setState(WaitForSelectorState.VISIBLE).setTimeout(60000));
			getExtentTest().log(Status.INFO, "Exiplicitly wait applyed succesfully on- " + elementName);
		} catch (TimeoutError e) {
			getExtentTest().log(Status.INFO, "Did'n apply Exiplicitly wait on - " + elementName);
			throw e;
		}
	}

	/*
	 * Playwright's LocatorAssertions (assertThat(locator).hasText(...)) is the
	 * idiomatic way to wait-for-text, but to stay dependency-parallel with the
	 * original we poll here instead.
	 */
	public void waitforTextToBePresentinElement(Locator element, String text, String elementName) {
		try {
			long deadline = System.currentTimeMillis() + 60000;
			while (System.currentTimeMillis() < deadline) {
				if (element.innerText().contains(text)) {
					getExtentTest().log(Status.INFO, "Exiplicitly wait applyed succesfully on- " + elementName);
					return;
				}
				getPage().waitForTimeout(250);
			}
			throw new TimeoutError("Text '" + text + "' not present in " + elementName + " within timeout");
		} catch (Exception e) {
			getExtentTest().log(Status.INFO, "Did'n apply Exiplicitly wait on - " + elementName);
			throw e;
		}
	}

