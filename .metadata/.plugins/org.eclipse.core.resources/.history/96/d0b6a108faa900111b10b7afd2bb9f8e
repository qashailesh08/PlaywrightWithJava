	/*
	 * Playwright closes a single page or the whole context/browser - there is no
	 * separate "close current window" vs "quit the driver" distinction tied to
	 * native OS windows.
	 */
	public void closeWindow() {
		getPage().close();
	}

	public void quit(long time) {
		try {
			Thread.sleep(time);
			getExtentTest().log(Status.INFO, "Browser Closed");
		} catch (InterruptedException e) {
			getExtentTest().log(Status.FAIL, "Did'n close browser");
			e.printStackTrace();
		}
		BrowserContext context = poolContext.get();
		if (context != null) {
			context.close();
		}
		Browser browser = poolBrowser.get();
		if (browser != null) {
			browser.close();
		}
		Playwright playwright = poolPlaywright.get();
		if (playwright != null) {
			playwright.close();
		}
	}

	/*
	 * Frame handling: Playwright's FrameLocator is selector-scoped and stateless -
	 * there's no "switchTo()" that changes the driver's focus. Every subsequent
	 * locator built off a FrameLocator automatically targets that frame, so callers
	 * should keep using the returned FrameLocator instead of mutating shared driver
	 * state.
	 */
	public FrameLocator handleFrame(String nameOrIdSelector) {
		try {
			FrameLocator frameLocator = getPage().frameLocator(nameOrIdSelector);
			getExtentTest().log(Status.INFO, "frame targeted succesfully");
			return frameLocator;
		} catch (Exception e) {
			getExtentTest().log(Status.FAIL, "Did not target the frame");
			throw e;
		}
	}

	public Frame handleFrame(int index) {
		try {
			Frame frame = getPage().frames().get(index);
			getExtentTest().log(Status.INFO, "frame targeted succesfully");
			return frame;
		} catch (Exception e) {
			getExtentTest().log(Status.FAIL, "Did not target the frame");
			throw e;
		}
	}

