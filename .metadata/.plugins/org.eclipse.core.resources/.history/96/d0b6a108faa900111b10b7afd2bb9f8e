			getExtentTest().log(Status.FAIL,
					"actulaValue: '" + actulaValue + "' not matched with excpectedValue: '" + excpectedValue);
		}
	}

	public void intValidation(int actulaIndex, int expectedIndex) {
		if (actulaIndex == expectedIndex) {
