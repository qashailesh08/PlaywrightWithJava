package test;

import org.testng.annotations.Test;
import base.Base;
import pages.AddToCard;
import pages.DemoBlazeLoginPage;

public class Run extends Base {

	@Test(priority = 1, groups = { "@Smoke" })
	public void test_01_Login() {
		webUtil.openUrl("https://demowebshop.tricentis.com/login");
		DemoBlazeLoginPage demo = new DemoBlazeLoginPage(page);
		demo.verifyLoginPageTitle("Demo Web Shop. Login");
		demo.login("qa.shailesh08@gmail.com", "shailesh08");
	}

	@Test(priority = 2,enabled = false, groups = { "@Smoke" })
	public void test_002_add_product_to_card() {
		webUtil.openUrl("https://demowebshop.tricentis.com/login");
		DemoBlazeLoginPage demo = new DemoBlazeLoginPage(page);
		AddToCard add = new AddToCard(page);
		demo.verifyLoginPageTitle("Demo Web Shop. Login");
		demo.login("qa.shailesh08@gmail.com", "shailesh08");
		add.addProductToCard("Laptop");
	}

	@Test(priority = 3,enabled = false,groups = { "@Smoke" })
	public void test_003_remove_product() {
		webUtil.openUrl("https://demowebshop.tricentis.com/login");
		DemoBlazeLoginPage demo = new DemoBlazeLoginPage(page);
		AddToCard add = new AddToCard(page);
		demo.verifyLoginPageTitle("Demo Web Shop. Login");
		demo.login("qa.shailesh08@gmail.com", "shailesh08");
		add.removeFromAddToCard();
	}
}
