package pages;

import com.microsoft.playwright.Locator;
import com.microsoft.playwright.Page;

public class DemoBlazeLoginPage {

	protected Page page;

	protected String loginbutton1;
	protected String userEmail;
	protected String userPassword;
	protected String rememberMe;
	protected String login;

	public DemoBlazeLoginPage(Page page) {
		this.page = page;
		this.loginbutton1 = page.locator("//a[text()='Log in']");
		this.userEmail = page.locator("#Email");
		this.userPassword = page.locator("#Password");
		this.rememberMe = page.locator("#RememberMe");
		this.login = page.locator("input[value='Log in']");

	}

	public void login(String userEmail, String password) {
		
		page.click(loginbutton1);

	}

}
